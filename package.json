{
  "name": "minirush",
  "version": "0.1.0",
  "description": "MiniRush Outbreak GP \u2014 mobile-first zombie racing for the web",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "smoke": "node scripts/smoke.mjs",
    "check:workshop": "node scripts/workshop-check.mjs",
    "check:workshop-edge": "node scripts/workshop-edge-check.mjs",
    "stress": "node scripts/stress.mjs",
    "check:parts": "node scripts/check-parts-workshop.mjs",
    "check:race-rules": "node --experimental-strip-types scripts/check-race-rules.mjs",
    "check:economy-server": "tsc --ignoreConfig --noEmit --target ES2022 --module ESNext --moduleResolution bundler --types node --skipLibCheck --strict convex/near.ts convex/nearDb.ts convex/schema.ts",
    "check:market": "node scripts/check-cinematic-market.mjs",
    "check:race-workshop": "node scripts/check-race-workshop.mjs",
    "check:test-drive": "node scripts/check-test-drive.mjs",
    "check:handling-rivals": "node scripts/check-handling-rivals.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "borsh": "^2.0.0",
    "near-api-js": "^7.4.0",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "convex": "^1.45.0",
    "meshoptimizer": "^1.2.0",
    "obj2gltf": "^3.2.0",
    "playwright": "^1.61.1",
    "viem": "^2.55.0"
  }
}
