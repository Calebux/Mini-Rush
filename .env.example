# --- Nimiq Pay (Mini App) ------------------------------------------------
# All optional: without them the game is fully playable, the garage market
# stays off and the results screen doesn't offer to mint a receipt.

# Nimiq address that receives garage-car purchases. Also the default anchor
# for race receipts. User-friendly format, spaces optional.
VITE_MARKET_RECEIVER=NQ00 0000 0000 0000 0000 0000 0000 0000 0000

# Separate anchor address for race receipts, if you don't want them landing
# on the market receiver. Defaults to VITE_MARKET_RECEIVER.
#VITE_RECEIPT_RECEIVER=

# Albatross JSON-RPC endpoint. The Mini App provider exposes accounts,
# signing and sending but no balance read, so the NIM balance in the profile
# and wallet chip only appears when this is set.
#VITE_NIMIQ_RPC_URL=

# --- Weekly bounty (docs/bounty.md) ----------------------------------------
# The prize goes to the fastest win of the week's HARDCORE race. Entries are
# receipts, so VITE_RECEIPT_RECEIVER (or VITE_MARKET_RECEIVER) must be a real
# NQ address for players to enter.
# Prize weeks are posted in the Convex dashboard (bountyWeeks table): set the
# production deployment URL once and no bounty ever needs a redeploy. Public.
# The same URL carries the worldwide boards — today's daily, the fastest bounty
# wins and the Weekend GP ghosts (convex/boards.ts, convex/weekend.ts). Without
# it every board falls back to the one held on the phone.
#VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Without Convex: the ISO week a prize is posted (the bounty card lights up and
# the entry button appears only that week) and its prize text, at build time.
# Both are ignored once VITE_CONVEX_URL is set.
#VITE_BOUNTY_WEEK=2026-W38
#VITE_BOUNTY_PRIZE=$20 in NIM
